# systemd unit for serumgen web on a VPS.
#
# Install:
#   sudo cp deploy/serumgen.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now serumgen
#
# Edit the three placeholders below first: YOUR_USER, the repo path, and
# the password. See deploy/README.md for the full walkthrough.

[Unit]
Description=serumgen web — Serum preset generator demo
After=network.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/serumgen
Environment=SERUMGEN_PASSWORD=change-this-password
ExecStart=/home/YOUR_USER/serumgen/.venv/bin/serumgen web --host 0.0.0.0 --port 8765 --no-open
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
